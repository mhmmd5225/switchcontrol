// Windows resources for switchcontrol.exe: the icon Explorer and the
// taskbar show, and the name Task Manager shows.
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SwitchControl"
            VALUE "ProductName", "SwitchControl"
            VALUE "OriginalFilename", "switchcontrol.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
